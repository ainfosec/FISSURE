- name: matched_taps
  id: variable
  parameters:
    comment: ''
    value: np.conjugate(np.exp(1j*2*np.pi*np.cumsum(((-bw/2)+(bw/ton)*(np.arange(Nmatch)/samp_rate)))/samp_rate)[::-1])
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 184
    - 176
    rotation: 0
    state: enabled
- name: power_taps
  id: variable
  parameters:
    comment: ''
    value: firdes.low_pass(1.0, samp_rate, lpf_cutoff, lpf_trans, firdes.WIN_HAMMING, 6.76)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
